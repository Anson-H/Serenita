      },
      "entity_identity_adaptation": {
        "normalizer": "task2_service/extraction/entity_resolution.py copied unchanged to backend/app/application/memory/sag/entity_names.py",
        "resolver": "worker.py _resolve_entity_id, _find_existing_entity_id and _record_entity_aliases adapted in backend/app/application/memory/sag/entity_resolution.py; same decision order, readable member catalog and staged append replace ORM reads/inserts; new IDs include the operation scope to avoid inaccessible historical identities",
        "prompt": "sag.py _build_requirements entity identity paragraph copied into sag_extract.yaml; catalog location adapted to data.meta.entity_catalog",
        "persistence": "Current name and aliases append to entity_names with source event in the same event transaction; immutable existing rows remain unchanged"
      }
    }
  }
