{
  "name": "serenita-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "tsc -p tests/tsconfig.json && playwright test",
    "build": "tsc -b && vite build && node scripts/check-js-chunks.mjs",
    "preview": "vite preview",
    "test:integration": "tsc -p tests/tsconfig.json && playwright test -c playwright.integration.config.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
